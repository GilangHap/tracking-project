# === VPS PRODUCTION (.env di server) ===
# Password Postgres internal (compose). WAJIB diganti, min 16 char acak.
POSTGRES_PASSWORD=ganti-dengan-password-kuat-min-16-char

# Secret Auth.js — generate: openssl rand -base64 32
AUTH_SECRET=ganti-dengan-string-acak-min-32-byte

# URL publik TANPA trailing slash. Dipakai render QR + link.
# HARUS https domain valid agar kamera HP jalan.
APP_URL=https://tracking.langhap.dev
NEXT_PUBLIC_SITE_URL=https://tracking.langhap.dev

# === DEV LOKAL (cukup 3 ini di .env.local) ===
# DATABASE_URL=postgresql://tracker:postgres@localhost:5433/tracker
# AUTH_SECRET=dev-secret-bebas-min-32-char
# NEXT_PUBLIC_SITE_URL=http://localhost:3000
